# ── LLM provider ─────────────────────────────────────────────
# AI Hub provider name: deepseek | openai | anthropic | kimi | zai | zhipu | gemini | xai | openrouter
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat

# API key for the provider above (DeepSeek: https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Generic fallback key checked for any provider (optional)
# AI_API_KEY=

# Custom base URL for OpenAI-compatible endpoints (optional)
# AI_BASE_URL=

# ── Agent behavior ───────────────────────────────────────────
# 1 = run without an LLM key: the AI Risk Agent operation returns deterministic
#     mock decisions so the whole production still works end to end.
# 0 = call the real AI Hub agent (requires the API key above)
AGENT_MOCK=0
